{
  "name": "zettel",
  "version": "0.26.0-rc.1",
  "description": "Offline-first invoice generator with ZUGFeRD/Factur-X support",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node -e \"require('node:fs').rmSync('.svelte-check',{recursive:true,force:true})\" && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/build-bundled-python.mjs && tauri build --config src-tauri/tauri.bundle.conf.json",
    "version:set": "node scripts/version.mjs set",
    "version:check": "node scripts/version.mjs check"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-sql": "^2.6.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "bits-ui": "^2.22.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "svelte-spa-router": "^5.1.1",
    "tailwind-merge": "^3.7.1",
    "tailwind-variants": "^4.0.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "MIT"
}
