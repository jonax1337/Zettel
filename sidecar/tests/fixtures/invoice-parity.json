{
  "_comment": "Shared by src/lib/utils/invoice-parity.test.ts (app) and sidecar/tests/test_cli_parity.py (cli/zettel.py). Change an expectation only when the rule changes in both places.",
  "totals": [
    {
      "name": "single line with 19 % VAT",
      "items": [{ "quantity": 1, "unitPrice": 10000, "vatRate": 19 }],
      "isKleinunternehmer": false,
      "isReverseCharge": false,
      "expected": { "subtotal": 10000, "vatAmount": 1900, "total": 11900 }
    },
    {
      "name": "VAT is rounded per line, not on the sum",
      "items": [
        { "quantity": 1, "unitPrice": 105, "vatRate": 7 },
        { "quantity": 1, "unitPrice": 105, "vatRate": 7 }
      ],
      "isKleinunternehmer": false,
      "isReverseCharge": false,
      "expected": { "subtotal": 210, "vatAmount": 14, "total": 224 }
    },
    {
      "name": "line total rounds half up",
      "items": [{ "quantity": 0.5, "unitPrice": 5, "vatRate": 0 }],
      "isKleinunternehmer": false,
      "isReverseCharge": false,
      "expected": { "subtotal": 3, "vatAmount": 0, "total": 3 }
    },
    {
      "name": "line total is the exact product (0,47 x 85,50 EUR is 40,185 EUR)",
      "items": [{ "quantity": 0.47, "unitPrice": 8550, "vatRate": 19 }],
      "isKleinunternehmer": false,
      "isReverseCharge": false,
      "expected": { "subtotal": 4019, "vatAmount": 764, "total": 4783 }
    },
    {
      "name": "line total is the exact product (4,1 x 0,15 EUR is 0,615 EUR)",
      "items": [{ "quantity": 4.1, "unitPrice": 15, "vatRate": 19 }],
      "isKleinunternehmer": false,
      "isReverseCharge": false,
      "expected": { "subtotal": 62, "vatAmount": 12, "total": 74 }
    },
    {
      "name": "negative discount line reduces the net and the VAT",
      "items": [
        { "quantity": 1, "unitPrice": 10000, "vatRate": 19 },
        { "quantity": -1, "unitPrice": 250, "vatRate": 19 }
      ],
      "isKleinunternehmer": false,
      "isReverseCharge": false,
      "expected": { "subtotal": 9750, "vatAmount": 1853, "total": 11603 }
    },
    {
      "name": "negative half cent line total rounds towards positive infinity",
      "items": [{ "quantity": 1.5, "unitPrice": -333, "vatRate": 19 }],
      "isKleinunternehmer": false,
      "isReverseCharge": false,
      "expected": { "subtotal": -499, "vatAmount": -95, "total": -594 }
    },
    {
      "name": "negative VAT half rounds towards positive infinity",
      "items": [{ "quantity": 1, "unitPrice": -250, "vatRate": 19 }],
      "isKleinunternehmer": false,
      "isReverseCharge": false,
      "expected": { "subtotal": -250, "vatAmount": -47, "total": -297 }
    },
    {
      "name": "mixed VAT rates",
      "items": [
        { "quantity": 2, "unitPrice": 4500, "vatRate": 19 },
        { "quantity": 1.5, "unitPrice": 3333, "vatRate": 7 }
      ],
      "isKleinunternehmer": false,
      "isReverseCharge": false,
      "expected": { "subtotal": 14000, "vatAmount": 2060, "total": 16060 }
    },
    {
      "name": "Kleinunternehmer charges no VAT",
      "items": [{ "quantity": 3, "unitPrice": 3333, "vatRate": 19 }],
      "isKleinunternehmer": true,
      "isReverseCharge": false,
      "expected": { "subtotal": 9999, "vatAmount": 0, "total": 9999 }
    },
    {
      "name": "reverse charge charges no VAT",
      "items": [{ "quantity": 1, "unitPrice": 12345, "vatRate": 19 }],
      "isKleinunternehmer": false,
      "isReverseCharge": true,
      "expected": { "subtotal": 12345, "vatAmount": 0, "total": 12345 }
    }
  ],
  "invoiceNumbers": [
    { "pattern": "RE-{YYYY}-{NNNN}", "counter": 1, "date": "2026-03-05", "expected": "RE-2026-0001" },
    { "pattern": "{YY}{MM}-{NNN}", "counter": 42, "date": "2026-11-30", "expected": "2611-042" },
    { "pattern": "R{N}", "counter": 12345, "date": "2026-01-01", "expected": "R12345" },
    { "pattern": "INV-{YYYY}{MM}-{NN}", "counter": 7, "date": "2025-01-09", "expected": "INV-202501-07" },
    { "pattern": "RE-{NNNN}", "counter": 12345, "date": "2026-06-15", "expected": "RE-12345" }
  ],
  "eurTotals": [
    { "currency": "EUR", "totalCent": 11900, "exchangeRate": null, "expected": 11900 },
    { "currency": "USD", "totalCent": 100, "exchangeRate": "1.08", "expected": 93 },
    { "currency": "USD", "totalCent": 10000, "exchangeRate": "1,0832", "expected": 9232 },
    { "currency": "USD", "totalCent": -10000, "exchangeRate": "1.0832", "expected": -9232 },
    { "currency": "GBP", "totalCent": 100000, "exchangeRate": "0.85", "expected": 117647 },
    { "currency": "USD", "totalCent": 10000, "exchangeRate": null, "expected": null },
    { "currency": "USD", "totalCent": 10000, "exchangeRate": "abc", "expected": null },
    { "currency": "USD", "totalCent": 10000, "exchangeRate": "0", "expected": null }
  ],
  "paymentTerms": [
    { "days": 14, "expected": "Zahlbar innerhalb von 14 Tagen ohne Abzug." },
    { "days": 30, "expected": "Zahlbar innerhalb von 30 Tagen ohne Abzug." }
  ],
  "xrechnungComplete": {
    "buyerReference": "04011000-1234512345-35",
    "company": {
      "companyName": "Laux Digital GmbH",
      "ownerName": "Jonas Laux",
      "street": "Musterstr. 1",
      "postalCode": "10115",
      "city": "Berlin",
      "phone": "+49 30 1234567",
      "email": "rechnung@laux.digital",
      "vatId": "DE123456789",
      "taxNumber": "",
      "bankIban": "DE89370400440532013000"
    },
    "customer": {
      "street": "Amtsplatz 1",
      "postalCode": "53113",
      "city": "Bonn",
      "email": "eingangsrechnung@bfb.example.de"
    }
  },
  "xrechnungMissing": [
    { "name": "complete data", "change": {}, "expected": [] },
    { "name": "no buyer reference", "change": { "buyerReference": null }, "expected": ["Leitweg-ID / Käuferreferenz"] },
    { "name": "blank buyer reference", "change": { "buyerReference": "   " }, "expected": ["Leitweg-ID / Käuferreferenz"] },
    { "name": "seller name", "change": { "company": { "companyName": " " } }, "expected": ["Firmenname des Verkäufers"] },
    { "name": "seller city", "change": { "company": { "city": "" } }, "expected": ["Anschrift des Verkäufers"] },
    { "name": "seller contact person", "change": { "company": { "ownerName": "" } }, "expected": ["Ansprechpartner des Verkäufers (Inhaber:in)"] },
    { "name": "seller phone without digits", "change": { "company": { "phone": "tel." } }, "expected": ["Telefonnummer des Verkäufers"] },
    { "name": "seller phone with two digits", "change": { "company": { "phone": "12" } }, "expected": ["Telefonnummer des Verkäufers"] },
    { "name": "formatted seller phone", "change": { "company": { "phone": "(030) 123 45" } }, "expected": [] },
    { "name": "seller email without @", "change": { "company": { "email": "kein-at-zeichen" } }, "expected": ["E-Mail-Adresse des Verkäufers"] },
    { "name": "seller email with two @", "change": { "company": { "email": "a@@b.de" } }, "expected": ["E-Mail-Adresse des Verkäufers"] },
    { "name": "tax number instead of VAT ID", "change": { "company": { "vatId": null, "taxNumber": "12/345/67890" } }, "expected": [] },
    { "name": "neither VAT ID nor tax number", "change": { "company": { "vatId": " ", "taxNumber": "" } }, "expected": ["USt-IdNr. oder Steuernummer des Verkäufers"] },
    { "name": "no IBAN", "change": { "company": { "bankIban": "" } }, "expected": ["Zahlungsweg (IBAN des Verkäufers)"] },
    { "name": "customer post code", "change": { "customer": { "postalCode": "" } }, "expected": ["Anschrift des Kunden"] },
    { "name": "customer email", "change": { "customer": { "email": null } }, "expected": ["E-Mail-Adresse des Kunden"] },
    {
      "name": "padded phone, email and owner name are accepted (the payload trims them)",
      "change": {
        "company": { "phone": "  +49 30 1234567 ", "email": " rechnung@laux.digital ", "ownerName": " Jonas Laux " },
        "customer": { "email": " eingangsrechnung@bfb.example.de " }
      },
      "expected": []
    },
    {
      "name": "several at once, in invoice, seller, customer order",
      "change": { "buyerReference": null, "company": { "phone": null, "bankIban": "" }, "customer": { "email": null } },
      "expected": [
        "Leitweg-ID / Käuferreferenz",
        "Telefonnummer des Verkäufers",
        "Zahlungsweg (IBAN des Verkäufers)",
        "E-Mail-Adresse des Kunden"
      ]
    }
  ],
  "xrechnungFallback": [
    { "name": "invoice and snapshot are complete", "invoiceBuyerReference": "A-1", "snapshotEmail": "a@b.de", "liveLeitwegId": "B-2", "liveEmail": "c@d.de", "expected": { "buyerReference": "A-1", "email": "a@b.de" } },
    { "name": "leitweg-id added to the customer after issuing", "invoiceBuyerReference": null, "snapshotEmail": "a@b.de", "liveLeitwegId": " B-2 ", "liveEmail": null, "expected": { "buyerReference": "B-2", "email": "a@b.de" } },
    { "name": "blank invoice reference falls back too", "invoiceBuyerReference": "  ", "snapshotEmail": "a@b.de", "liveLeitwegId": "B-2", "liveEmail": null, "expected": { "buyerReference": "B-2", "email": "a@b.de" } },
    { "name": "email added to the customer after issuing", "invoiceBuyerReference": "A-1", "snapshotEmail": null, "liveLeitwegId": null, "liveEmail": "c@d.de", "expected": { "buyerReference": "A-1", "email": "c@d.de" } },
    { "name": "blank snapshot email falls back too", "invoiceBuyerReference": "A-1", "snapshotEmail": " ", "liveLeitwegId": null, "liveEmail": "c@d.de", "expected": { "buyerReference": "A-1", "email": "c@d.de" } },
    { "name": "nothing to fall back to", "invoiceBuyerReference": null, "snapshotEmail": null, "liveLeitwegId": null, "liveEmail": null, "expected": { "buyerReference": null, "email": null } }
  ]
}
