<!doctype html>
{% from '_partials.j2' import masthead, addressee, meta_row, items_table, totals_table, notes_block, footer %}
{% set lang = offer.pdfLanguage or 'de' %}
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8" />
  <title>{{ t('doctype_offer', lang) }} {{ offer.number }}</title>
</head>
<body class="theme-{{ settings.pdf_theme if settings and settings.pdf_theme else 'classic' }}">

  {{ masthead(company, t('doctype_offer', lang), offer.number) }}

  <section class="parties">
    {{ addressee(company, customer, t('addr_attention', lang)) }}

    <div class="meta">
      {{ meta_row(t('meta_offer_no', lang), offer.number) }}
      {{ meta_row(t('meta_offer_date', lang), offer.issueDate | date_unix) }}
      {{ meta_row(t('meta_valid_until', lang), offer.validUntil | date_unix) }}
      {% if offer.servicePeriodStart and offer.servicePeriodEnd %}
      {{ meta_row(t('meta_service_period', lang), (offer.servicePeriodStart | date_unix) ~ ' – ' ~ (offer.servicePeriodEnd | date_unix)) }}
      {% endif %}
      {% if customer.vatId %}
      {{ meta_row(t('meta_customer_vatid', lang), customer.vatId) }}
      {% endif %}
    </div>
  </section>

  {% if offer.introText %}
    <section class="block">
      <div class="notes">{{ offer.introText | nl2br }}</div>
    </section>
  {% endif %}

  {{ items_table(items, offer, lang) }}

  {{ totals_table(offer, vat_groups, lang) }}

  {% if offer.isKleinunternehmer and company.kleinunternehmerNote %}
    <p class="callout">{{ company.kleinunternehmerNote }}</p>
  {% endif %}

  {% if offer.isReverseCharge %}
    <p class="callout">{{ t('offer_rc_hint_goods' if offer.supplyKind == 'goods' else 'offer_rc_hint_services', lang) }}</p>
  {% endif %}

  <p class="callout">
    {{ t('offer_disclaimer', lang, date=offer.validUntil | date_unix) }}
  </p>

  {% if offer.skontoPercent and offer.skontoDays and offer.skontoAmountCent %}
  <section class="block">
    <div class="block-title">{{ t('block_skonto_offer', lang) }}</div>
    <p class="skonto-line">
      {{ t('skonto_offer_text', lang, days=offer.skontoDays, percent='%.1f'|format(offer.skontoPercent)) }}
    </p>
  </section>
  {% endif %}

  {% if offer.notes %}
    {{ notes_block(offer.notes, lang) }}
  {% endif %}

  {{ footer(company, lang) }}

</body>
</html>
