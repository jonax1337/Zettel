<!doctype html>
{% from '_partials.j2' import masthead, addressee, meta_row, items_table, totals_table, notes_block, footer %}
{% set lang = invoice.pdfLanguage or 'de' %}
{% set doctype = t('doctype_credit_note' if invoice.isCreditNote else 'doctype_invoice', lang) %}
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8" />
  <title>{{ doctype }} {{ invoice.number }}</title>
</head>
<body class="theme-{{ settings.pdf_theme if settings and settings.pdf_theme else 'classic' }}">

  {{ masthead(company, doctype, invoice.number) }}

  {% if invoice.isCreditNote and invoice.correctsInvoice %}
  <section class="callout">
    {{ t('credit_note_ref', lang, number=invoice.correctsInvoice.number, date=invoice.correctsInvoice.issueDate | date_unix) }}
  </section>
  {% endif %}

  <section class="parties">
    {{ addressee(company, customer, t('addr_attention', lang)) }}

    <div class="meta">
      {{ meta_row(t('meta_invoice_no', lang), invoice.number) }}
      {{ meta_row(t('meta_issue_date', lang), invoice.issueDate | date_unix) }}
      {% if invoice.servicePeriodStart and invoice.servicePeriodEnd %}
      {{ meta_row(t('meta_service_period', lang), (invoice.servicePeriodStart | date_unix) ~ ' – ' ~ (invoice.servicePeriodEnd | date_unix)) }}
      {% elif invoice.deliveryDate %}
      {{ meta_row(t('meta_delivery_date', lang), invoice.deliveryDate | date_unix) }}
      {% endif %}
      {% if not invoice.isCreditNote %}
      {{ meta_row(t('meta_due_date', lang), invoice.dueDate | date_unix) }}
      {% endif %}
      {% if customer.vatId %}
      {{ meta_row(t('meta_customer_vatid', lang), customer.vatId) }}
      {% endif %}
    </div>
  </section>

  {{ items_table(items, invoice, lang, -1 if invoice.isCreditNote else 1) }}

  {% call totals_table(invoice, vat_groups, lang) %}
    {% if paid_cent %}
      <tr class="paid-line">
        {% if invoice.isCreditNote %}
        <th>{{ t('totals_already_refunded', lang) }}</th>
        <td>{{ paid_cent | eur(invoice.currency) }}</td>
        {% else %}
        <th>{{ t('totals_already_paid', lang) }}</th>
        <td>− {{ paid_cent | eur(invoice.currency) }}</td>
        {% endif %}
      </tr>
      <tr class="grand">
        <th>{{ t('totals_remaining', lang) }}</th>
        <td>{{ open_cent | eur(invoice.currency) }}</td>
      </tr>
    {% endif %}
  {% endcall %}

  {% if invoice.isKleinunternehmer and company.kleinunternehmerNote %}
    <p class="callout">{{ company.kleinunternehmerNote }}</p>
  {% endif %}

  {% if invoice.reverseChargeType == 'intra_eu' %}
    <p class="callout">{{ t('rc_intra_eu_goods' if invoice.supplyKind == 'goods' else 'rc_intra_eu_services', lang) }}</p>
  {% elif invoice.reverseChargeType == 'third_country' %}
    <p class="callout">{{ t('rc_third_country' if invoice.supplyKind == 'goods' else 'rc_third_country_services', lang) }}</p>
  {% endif %}

  {% if invoice.isCreditNote %}
    <section class="block">
      <div class="block-title">{{ t('block_refund_title', lang) }}</div>
      <p>{{ t('block_refund_body', lang) }}</p>
    </section>
  {% elif invoice.paymentTerms or invoice.skontoPercent or epc_qr_uri %}
    <section class="block payment-block">
      <div class="payment-text">
        {% if invoice.paymentTerms %}
        <div class="block-title">{{ t('block_payment_terms', lang) }}</div>
        <p>{{ invoice.paymentTerms }}</p>
        {% endif %}
        {% if invoice.skontoPercent and invoice.skontoDays and invoice.skontoAmountCent %}
        <p class="skonto-line">
          {{ t('skonto_inline', lang,
                date=invoice.skontoDeadline | date_unix,
                percent='%.1f'|format(invoice.skontoPercent),
                amount=invoice.skontoAmountCent | eur(invoice.currency)) }}
        </p>
        {% endif %}
      </div>
      {% if epc_qr_uri %}
      <div class="payment-qr">
        <img class="epc-qr" src="{{ epc_qr_uri }}" alt="EPC-QR-Code" />
        <div class="epc-qr-label">{{ t('epc_qr_caption_line1', lang) }}<br/>{{ t('epc_qr_caption_line2', lang) }}</div>
      </div>
      {% endif %}
    </section>
  {% endif %}

  {% if invoice.notes %}
    {{ notes_block(invoice.notes, lang) }}
  {% endif %}

  {{ footer(company, lang, with_bank=true) }}

</body>
</html>
